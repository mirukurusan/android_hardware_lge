type hal_soi_default, domain;
hal_server_domain(hal_soi_default, hal_soi)

type hal_soi_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_soi_default)

allow hal_soi_default self:qipcrtr_socket create_socket_perms_no_ioctl;
allow hal_soi_default self:socket create_socket_perms_no_ioctl;
allow hal_soi_default self:socket ioctl;
allowxperm hal_soi_default self:socket ioctl msm_sock_ipc_ioctls;
