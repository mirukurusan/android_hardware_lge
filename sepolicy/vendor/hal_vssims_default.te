type hal_vssims_default, domain;
hal_server_domain(hal_vssims_default, hal_vssims)

type hal_vssims_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_vssims_default)

allow hal_vssims_default self:qipcrtr_socket create_socket_perms_no_ioctl;
allow hal_vssims_default self:socket create_socket_perms_no_ioctl;
allow hal_vssims_default self:socket ioctl;
allowxperm hal_vssims_default self:socket ioctl msm_sock_ipc_ioctls;
